<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_Vitelsa" targetNamespace="http://ustavillavicencio.edu.co/bpmn/vitelsa" exporter="Equipo salida académica" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Vitelsa">
    <bpmn:participant id="Pool_Vitelsa" name="Vitelsa – Planta Bucaramanga: transformación e inspección de vidrio" processRef="Proc_Vitelsa" />
    <bpmn:textAnnotation id="Ann_conv"><bpmn:text>Convención: (O) observado en la visita del 15/09/2026; (S) fuente secundaria; (I) inferido por el equipo. Las tareas "(propuesta)" corresponden al sistema de inspección visual del informe (Parte III).</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Proc_Vitelsa" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_com" name="Comercial">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pedido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_prep" name="Preparación y corte">
        <bpmn:flowNodeRef>t_recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cortar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_limpiar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_cal" name="Calidad">
        <bpmn:flowNodeRef>t_insp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ok1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ok2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rech</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_tem" name="Templado">
        <bpmn:flowNodeRef>t_calentar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enfriar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_lam" name="Laminado">
        <bpmn:flowNodeRef>t_ensamblar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prensar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_des" name="Despacho">
        <bpmn:flowNodeRef>t_embalar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_despachar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Pedido recibido">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_pedido" name="Registrar pedido (I)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_recibir" name="Recibir vidrio crudo (O)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_cortar" name="Preparar y cortar a medida (O)">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_limpiar" name="Limpiar pieza (O)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="t_insp1" name="Inspección automática 1 post-limpieza (propuesta)">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_ok1" name="¿Pieza sin defecto?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_tipo" name="¿Tipo de vidrio?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_calentar" name="Calentar en horno industrial (O)">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_enfriar" name="Enfriar con aire (S)">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_ensamblar" name="Ensamblar láminas con película intermedia (I)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_prensar" name="Prensar y curar en autoclave (I)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_join">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_final" name="Inspección final (O) y automática 2 (propuesta)">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_ok2" name="¿Cumple calidad?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_rechazo" name="Registrar rechazo y causa (I)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_rech" name="Pieza rechazada">
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_embalar" name="Embalar (I)">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_despachar" name="Despachar a cliente u obra (I)">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_ok" name="Pedido despachado">
      <bpmn:incoming>f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_pedido" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_pedido" targetRef="t_recibir" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_recibir" targetRef="t_cortar" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_cortar" targetRef="t_limpiar" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_limpiar" targetRef="t_insp1" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_insp1" targetRef="gw_ok1" />
    <bpmn:sequenceFlow id="f7" name="Sí" sourceRef="gw_ok1" targetRef="gw_tipo" />
    <bpmn:sequenceFlow id="f8" name="No" sourceRef="gw_ok1" targetRef="t_rechazo" />
    <bpmn:sequenceFlow id="f9" name="Templado" sourceRef="gw_tipo" targetRef="t_calentar" />
    <bpmn:sequenceFlow id="f10" name="Laminado" sourceRef="gw_tipo" targetRef="t_ensamblar" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_calentar" targetRef="t_enfriar" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_ensamblar" targetRef="t_prensar" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_enfriar" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_prensar" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f15" sourceRef="gw_join" targetRef="t_final" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_final" targetRef="gw_ok2" />
    <bpmn:sequenceFlow id="f17" name="Sí" sourceRef="gw_ok2" targetRef="t_embalar" />
    <bpmn:sequenceFlow id="f18" name="No" sourceRef="gw_ok2" targetRef="t_rechazo" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_rechazo" targetRef="end_rech" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_embalar" targetRef="t_despachar" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_despachar" targetRef="end_ok" />
  </bpmn:process>
