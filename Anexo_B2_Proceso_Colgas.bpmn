<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_Colgas" targetNamespace="http://ustavillavicencio.edu.co/bpmn/colgas" exporter="Equipo salida académica" exporterVersion="1.0">
<bpmn:collaboration id="Collab_Colgas">
<bpmn:participant id="Pool_Colgas" name="Colgas S.A. E.S.P. – Distribución de GLP en cilindros y a granel (modelo de alto nivel con fuentes secundarias)" processRef="Proc_Colgas" />
<bpmn:textAnnotation id="Ann_conv"><bpmn:text>Convención: (S) fuente secundaria (SSPD, 2024; Ministerio de Minas y Energía, 2016); (I) inferido por el equipo. Colgas no fue visitada por el equipo: ninguna tarea se marca como observada.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="Ann_tel"><bpmn:text>Oportunidad (I): telemetría de nivel de tanques estacionarios y de la flota por MQTT, con el mismo patrón borde-nube de la Parte III.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_tel" sourceRef="t_granel" targetRef="Ann_tel" />
</bpmn:collaboration>
<bpmn:process id="Proc_Colgas" isExecutable="false"><bpmn:laneSet id="LaneSet_C">
<bpmn:lane id="L_com" name="Comercial y regulatorio"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>t_prog</bpmn:flowNodeRef><bpmn:flowNodeRef>t_sui</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_pla" name="Abastecimiento y planta de envasado"><bpmn:flowNodeRef>t_recibo</bpmn:flowNodeRef><bpmn:flowNodeRef>t_alm</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_dest</bpmn:flowNodeRef><bpmn:flowNodeRef>t_envasar</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_cal" name="Calidad y seguridad de cilindros"><bpmn:flowNodeRef>t_revisar</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_apto</bpmn:flowNodeRef><bpmn:flowNodeRef>t_retiro</bpmn:flowNodeRef><bpmn:flowNodeRef>end_retiro</bpmn:flowNodeRef><bpmn:flowNodeRef>t_verif</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_log" name="Logística y distribución"><bpmn:flowNodeRef>t_granel</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cargar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_distribuir</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start" name="Demanda de clientes"><bpmn:outgoing>g1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="t_prog" name="Programar abastecimiento y despachos (I)"><bpmn:incoming>g1</bpmn:incoming><bpmn:outgoing>g2</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_recibo" name="Recibir GLP a granel (S)"><bpmn:incoming>g2</bpmn:incoming><bpmn:outgoing>g3</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_alm" name="Almacenar en tanques de la planta (S)"><bpmn:incoming>g3</bpmn:incoming><bpmn:outgoing>g4</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="gw_dest" name="¿Cilindros o granel?"><bpmn:incoming>g4</bpmn:incoming><bpmn:outgoing>g5</bpmn:outgoing><bpmn:outgoing>g6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t_revisar" name="Recibir y revisar cilindros marcados (S)"><bpmn:incoming>g5</bpmn:incoming><bpmn:outgoing>g7</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="gw_apto" name="¿Cilindro apto?"><bpmn:incoming>g7</bpmn:incoming><bpmn:outgoing>g8</bpmn:outgoing><bpmn:outgoing>g9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t_retiro" name="Retirar a mantenimiento o destrucción (S)"><bpmn:incoming>g9</bpmn:incoming><bpmn:outgoing>g10</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="end_retiro" name="Cilindro fuera de servicio"><bpmn:incoming>g10</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="t_envasar" name="Envasar por trasiego con báscula (S)"><bpmn:incoming>g8</bpmn:incoming><bpmn:outgoing>g11</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_verif" name="Verificar peso y hermeticidad (I)"><bpmn:incoming>g11</bpmn:incoming><bpmn:outgoing>g12</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_granel" name="Cargar carrotanque y entregar a tanque estacionario (S)"><bpmn:incoming>g6</bpmn:incoming><bpmn:outgoing>g15</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_cargar" name="Cargar vehículos de reparto (I)"><bpmn:incoming>g12</bpmn:incoming><bpmn:outgoing>g13</bpmn:outgoing></bpmn:task>
<bpmn:task id="t_distribuir" name="Distribuir a expendios, depósitos y usuarios (S)"><bpmn:incoming>g13</bpmn:incoming><bpmn:outgoing>g14</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="gw_join"><bpmn:incoming>g14</bpmn:incoming><bpmn:incoming>g15</bpmn:incoming><bpmn:outgoing>g16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="t_sui" name="Reportar información regulatoria al SUI (S)"><bpmn:incoming>g16</bpmn:incoming><bpmn:outgoing>g17</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="end_ok" name="Producto entregado y reportado"><bpmn:incoming>g17</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="g1" sourceRef="start" targetRef="t_prog" />
<bpmn:sequenceFlow id="g2" sourceRef="t_prog" targetRef="t_recibo" />
<bpmn:sequenceFlow id="g3" sourceRef="t_recibo" targetRef="t_alm" />
<bpmn:sequenceFlow id="g4" sourceRef="t_alm" targetRef="gw_dest" />
<bpmn:sequenceFlow id="g5" name="Cilindros" sourceRef="gw_dest" targetRef="t_revisar" />
<bpmn:sequenceFlow id="g6" name="Granel" sourceRef="gw_dest" targetRef="t_granel" />
<bpmn:sequenceFlow id="g7" sourceRef="t_revisar" targetRef="gw_apto" />
<bpmn:sequenceFlow id="g8" name="Sí" sourceRef="gw_apto" targetRef="t_envasar" />
<bpmn:sequenceFlow id="g9" name="No" sourceRef="gw_apto" targetRef="t_retiro" />
<bpmn:sequenceFlow id="g10" sourceRef="t_retiro" targetRef="end_retiro" />
<bpmn:sequenceFlow id="g11" sourceRef="t_envasar" targetRef="t_verif" />
<bpmn:sequenceFlow id="g12" sourceRef="t_verif" targetRef="t_cargar" />
<bpmn:sequenceFlow id="g13" sourceRef="t_cargar" targetRef="t_distribuir" />
<bpmn:sequenceFlow id="g14" sourceRef="t_distribuir" targetRef="gw_join" />
<bpmn:sequenceFlow id="g15" sourceRef="t_granel" targetRef="gw_join" />
<bpmn:sequenceFlow id="g16" sourceRef="gw_join" targetRef="t_sui" />
<bpmn:sequenceFlow id="g17" sourceRef="t_sui" targetRef="end_ok" />
</bpmn:process>
